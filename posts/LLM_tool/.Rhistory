credentials=Sys.getenv("OPENROUTER_API_KEY"),
model="minimax/minimax-m2.7"
)
chat = chat_openai_compatible(base_url='https://openrouter.ai/api/v1',
api_key=Sys.getenv("OPENROUTER_API_KEY"),
model="minimax/minimax-m2.7"
)
