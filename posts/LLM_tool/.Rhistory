api_key=Sys.getenv("OPENROUTER_API_KEY"),
model="minimax/minimax-m2.7"
)
llm_use(chat)
reviews |>
llm_sentiment(review)
chat = chat_openai_compatible(
base_url='https://openrouter.ai/api/v1',
api_key=Sys.getenv("OPENROUTER_API_KEY"),
model="minimax/minimax-m2.7"
)
llm_use(chat)
reviews |>
llm_summarize(review, max_words = 5)
reviews |>
